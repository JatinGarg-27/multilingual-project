# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1/text-to-speech
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# "Rachel" — ElevenLabs' standard premade voice, available on every account.
# Swap for a voice_id from your own ElevenLabs Voice Library if you prefer.
DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Address other services (and you, for manual testing) can reach this service at.
# docker compose: http://tts-service:8002   |   local non-docker dev: http://localhost:8002
PUBLIC_BASE_URL=http://localhost:8002

# NOTE: ElevenLabs' eleven_multilingual_v2 model does not officially support
# Telugu (te) or Kannada (kn). Requests for those two languages are still
# accepted and forwarded, but output quality/accuracy is not guaranteed.
# See DECISION-004 in DECISION_LOG.md.
