# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/tts_copilot

# Auth
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Peer services
# Running locally (uvicorn on the host): http://localhost:8001 / :8002
# Running via docker compose: http://generation-service:8001 / http://tts-service:8002
GENERATION_SERVICE_URL=http://localhost:8001
TTS_SERVICE_URL=http://localhost:8002
